<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/sidebarHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sidebar_handle"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingTop="12dp"
        android:paddingEnd="7dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="3dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_overlay_handle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/telemetryPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_overlay"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/overlayHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFpsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="60"
                android:textColor="#00E5FF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="FPS"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#334155" />

            <TextView
                android:id="@+id/tvFrameTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_overlay_pill"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:text="16.6 ms"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnCollapseOverlay"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_overlay_pill"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="◀"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlayExtraStandard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTempValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_overlay_pill"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="--°C"
                android:textColor="#38BDF8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvBatteryValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_overlay_pill"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="--%"
                android:textColor="#A7F3D0"
                android:textSize="10sp" />
        </LinearLayout>

        <com.turbouro.app.ui.view.FrameTimeGraphView
            android:id="@+id/frameTimeGraphView"
            android:layout_width="190dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/overlayQuickActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnActionCleanRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_overlay_action_btn"
                android:clickable="true"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:text="🧹 RAM"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnActionDnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_overlay_action_btn"
                android:clickable="true"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:text="🔕 DND"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnActionCrosshair"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_overlay_action_btn"
                android:clickable="true"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:text="🎯 AIM"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnActionBrightness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_overlay_action_btn"
                android:clickable="true"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:text="☀️ KUNCI"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlayExtraFull"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCpuValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_overlay_pill"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="CPU: N/A"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvGpuValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_overlay_pill"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="GPU: N/A"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRefreshRateValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_overlay_pill"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Hz: --"
                android:textColor="#38BDF8"
                android:textSize="9sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
